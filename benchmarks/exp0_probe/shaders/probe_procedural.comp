#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 64) in;

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;

layout(std430, binding = 1, set = 0) writeonly buffer ResultBuffer {
    uint hitCount[];
};

layout(push_constant) uniform PushConstants {
    vec4 camPos;
    vec4 lookAt;
    uint rayCount;
    uint isCoherent; // 1 = coherent camera rays, 0 = incoherent pseudo-random rays
} pc;

// Simple LCG hash for procedural incoherent rays
uint pcg_hash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float hashFloat(uint seed) {
    return float(pcg_hash(seed)) * (1.0 / 4294967295.0);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.rayCount) return;

    vec3 origin;
    vec3 dir;

    if (pc.isCoherent == 1) {
        // Procedural camera grid (1024x1024)
        uint width = 1024;
        uint height = (pc.rayCount + width - 1) / width;
        uint x = idx % width;
        uint y = idx / width;

        float u = (float(x) + 0.5) / float(width) * 2.0 - 1.0;
        float v = (float(y) + 0.5) / float(height) * 2.0 - 1.0;

        origin = pc.camPos.xyz;
        vec3 fwd = normalize(pc.lookAt.xyz - pc.camPos.xyz);
        vec3 right = normalize(cross(fwd, vec3(0, 1, 0)));
        vec3 up = cross(right, fwd);

        dir = normalize(fwd + right * u * 0.55 + up * v * 0.55);
    } else {
        // Procedural incoherent rays inside scene bounds
        float rx = hashFloat(idx * 6 + 0) * 80.0 - 40.0;
        float ry = hashFloat(idx * 6 + 1) * 15.0 + 15.0;
        float rz = hashFloat(idx * 6 + 2) * 80.0 - 40.0;
        origin = vec3(rx, ry, rz);

        float dx = hashFloat(idx * 6 + 3) * 0.8 - 0.4;
        float dy = -1.0 - hashFloat(idx * 6 + 4) * 0.5;
        float dz = hashFloat(idx * 6 + 5) * 0.8 - 0.4;
        dir = normalize(vec3(dx, dy, dz));
    }

    rayQueryEXT rq;
    rayQueryInitializeEXT(
        rq,
        topLevelAS,
        gl_RayFlagsNoneEXT,
        0xFF,
        origin,
        0.01,
        dir,
        1000.0
    );

    while (rayQueryProceedEXT(rq)) {
        // Traversal
    }

    uint hit = (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) ? 1 : 0;
    hitCount[idx] = hit;
}
