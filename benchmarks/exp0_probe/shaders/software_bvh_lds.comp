#version 460

layout(local_size_x = 64) in;

struct GpuBvhNode {
    vec3 aabbMin;
    int leftChild;
    vec3 aabbMax;
    int rightChild;
};

struct GpuTriangle {
    vec4 v0;
    vec4 v1;
    vec4 v2;
};

layout(std430, binding = 0, set = 0) readonly buffer NodeBuffer {
    GpuBvhNode nodes[];
};

layout(std430, binding = 1, set = 0) readonly buffer TriangleBuffer {
    GpuTriangle triangles[];
};

layout(std430, binding = 2, set = 0) writeonly buffer ResultBuffer {
    uint hitCount[];
};

layout(push_constant) uniform PushConstants {
    vec4 camPos;
    vec4 lookAt;
    uint rayCount;
    uint isCoherent;
} pc;

shared uint s_stack[64][32];

uint pcg_hash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float hashFloat(uint seed) {
    return float(pcg_hash(seed)) * (1.0 / 4294967295.0);
}

bool intersectAABB(vec3 origin, vec3 invDir, vec3 bMin, vec3 bMax, float tCurrent, out float tBox) {
    vec3 t0 = (bMin - origin) * invDir;
    vec3 t1 = (bMax - origin) * invDir;
    vec3 tmin3 = min(t0, t1);
    vec3 tmax3 = max(t0, t1);

    float tNear = max(max(tmin3.x, tmin3.y), tmin3.z);
    float tFar  = min(min(tmax3.x, tmax3.y), tmax3.z);

    tBox = tNear;
    return (tFar >= max(0.0, tNear)) && (tNear < tCurrent);
}

bool intersectTriangle(vec3 orig, vec3 dir, vec3 v0, vec3 v1, vec3 v2, inout float tHit) {
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 h = cross(dir, edge2);
    float a = dot(edge1, h);

    if (abs(a) < 1e-8) return false;
    float f = 1.0 / a;
    vec3 s = orig - v0;
    float u = f * dot(s, h);
    if (u < 0.0 || u > 1.0) return false;

    vec3 q = cross(s, edge1);
    float v = f * dot(dir, q);
    if (v < 0.0 || u + v > 1.0) return false;

    float t = f * dot(edge2, q);
    if (t > 0.001 && t < tHit) {
        tHit = t;
        return true;
    }
    return false;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.rayCount) return;
    uint tid = gl_LocalInvocationIndex;

    vec3 origin;
    vec3 dir;

    if (pc.isCoherent == 1) {
        uint width = 1024;
        uint height = (pc.rayCount + width - 1) / width;
        uint x = idx % width;
        uint y = idx / width;

        float u = (float(x) + 0.5) / float(width) * 2.0 - 1.0;
        float v = (float(y) + 0.5) / float(height) * 2.0 - 1.0;

        origin = pc.camPos.xyz;
        vec3 fwd = normalize(pc.lookAt.xyz - pc.camPos.xyz);
        vec3 right = normalize(cross(fwd, vec3(0, 1, 0)));
        vec3 up = cross(right, fwd);

        dir = normalize(fwd + right * u * 0.55 + up * v * 0.55);
    } else {
        float rx = hashFloat(idx * 6 + 0) * 80.0 - 40.0;
        float ry = hashFloat(idx * 6 + 1) * 15.0 + 15.0;
        float rz = hashFloat(idx * 6 + 2) * 80.0 - 40.0;
        origin = vec3(rx, ry, rz);

        float dx = hashFloat(idx * 6 + 3) * 0.8 - 0.4;
        float dy = -1.0 - hashFloat(idx * 6 + 4) * 0.5;
        float dz = hashFloat(idx * 6 + 5) * 0.8 - 0.4;
        dir = normalize(vec3(dx, dy, dz));
    }

    vec3 invDir;
    invDir.x = 1.0 / (abs(dir.x) > 1e-8 ? dir.x : (dir.x >= 0.0 ? 1e-8 : -1e-8));
    invDir.y = 1.0 / (abs(dir.y) > 1e-8 ? dir.y : (dir.y >= 0.0 ? 1e-8 : -1e-8));
    invDir.z = 1.0 / (abs(dir.z) > 1e-8 ? dir.z : (dir.z >= 0.0 ? 1e-8 : -1e-8));

    float closestT = 1000.0;
    uint hitFound = 0;

    int stackPtr = 0;
    s_stack[tid][stackPtr++] = 0;

    while (stackPtr > 0) {
        uint nodeIdx = s_stack[tid][--stackPtr];
        GpuBvhNode node = nodes[nodeIdx];

        float tBox;
        if (!intersectAABB(origin, invDir, node.aabbMin, node.aabbMax, closestT, tBox)) {
            continue;
        }

        if (node.leftChild < 0) {
            uint primStart = uint(~node.leftChild);
            uint primCount = uint(node.rightChild);
            for (int i = 0; i < primCount; i++) {
                uint pIdx = primStart + i;
                GpuTriangle tri = triangles[pIdx];
                if (intersectTriangle(origin, dir, tri.v0.xyz, tri.v1.xyz, tri.v2.xyz, closestT)) {
                    hitFound = 1;
                }
            }
        } else {
            uint left = uint(node.leftChild);
            uint right = uint(node.rightChild);

            float tLeft, tRight;
            bool hitL = intersectAABB(origin, invDir, nodes[left].aabbMin, nodes[left].aabbMax, closestT, tLeft);
            bool hitR = intersectAABB(origin, invDir, nodes[right].aabbMin, nodes[right].aabbMax, closestT, tRight);

            if (hitL && hitR) {
                if (tLeft < tRight) {
                    s_stack[tid][stackPtr++] = right;
                    s_stack[tid][stackPtr++] = left;
                } else {
                    s_stack[tid][stackPtr++] = left;
                    s_stack[tid][stackPtr++] = right;
                }
            } else if (hitL) {
                s_stack[tid][stackPtr++] = left;
            } else if (hitR) {
                s_stack[tid][stackPtr++] = right;
            }
        }
    }

    hitCount[idx] = hitFound;
}
