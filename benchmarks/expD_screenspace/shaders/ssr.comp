#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outSSR;

layout(push_constant) uniform PushConstants {
    mat4 invViewProj;
    mat4 proj;
    vec4 camPos;
    uvec2 resolution;
    float maxDistance;
    uint maxSteps;
} pc;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.resolution.x || pixel.y >= pc.resolution.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.resolution);
    float depth = textureLod(depthTex, uv, 0.0).r;
    if (depth >= 1.0) {
        imageStore(outSSR, ivec2(pixel), vec4(0.05, 0.05, 0.08, 1.0));
        return;
    }

    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosH = pc.invViewProj * ndc;
    vec3 worldPos = worldPosH.xyz / worldPosH.w;

    vec2 texel = 1.0 / vec2(pc.resolution);
    float depthR = textureLod(depthTex, uv + vec2(texel.x, 0.0), 0.0).r;
    float depthU = textureLod(depthTex, uv + vec2(0.0, texel.y), 0.0).r;
    vec4 posRH = pc.invViewProj * vec4((uv + vec2(texel.x, 0.0)) * 2.0 - 1.0, depthR, 1.0);
    vec4 posUH = pc.invViewProj * vec4((uv + vec2(0.0, texel.y)) * 2.0 - 1.0, depthU, 1.0);
    vec3 normal = normalize(cross(posRH.xyz / posRH.w - worldPos, posUH.xyz / posUH.w - worldPos));

    vec3 V = normalize(worldPos - pc.camPos.xyz);
    vec3 R = reflect(V, normal);

    // Screen-space ray march
    uint steps = max(16u, pc.maxSteps);
    float stepSize = pc.maxDistance / float(steps);
    vec3 curPos = worldPos + normal * 0.05;

    vec3 reflCol = vec3(0.05, 0.05, 0.08); // Default sky
    float hit = 0.0;

    for (uint i = 0; i < steps; i++) {
        curPos += R * stepSize;

        vec4 pNDC = pc.proj * vec4(curPos, 1.0);
        pNDC.xyz /= pNDC.w;
        vec2 pUV = pNDC.xy * 0.5 + 0.5;

        if (pUV.x < 0.0 || pUV.x > 1.0 || pUV.y < 0.0 || pUV.y > 1.0 || pNDC.z < 0.0 || pNDC.z > 1.0) {
            break; // Off screen
        }

        float sceneDepth = textureLod(depthTex, pUV, 0.0).r;
        vec4 actualH = pc.invViewProj * vec4(pUV * 2.0 - 1.0, sceneDepth, 1.0);
        vec3 actualPos = actualH.xyz / actualH.w;

        float depthDiff = curPos.z - actualPos.z;
        if (depthDiff > 0.0 && depthDiff < stepSize * 1.5) {
            // Hit detected in screen space!
            hit = 1.0;
            // Screen edge fade
            vec2 edgeDist = min(pUV, 1.0 - pUV);
            float edgeFade = clamp(min(edgeDist.x, edgeDist.y) * 10.0, 0.0, 1.0);
            reflCol = mix(vec3(0.05, 0.05, 0.08), vec3(0.6, 0.65, 0.7), edgeFade);
            break;
        }
    }

    imageStore(outSSR, ivec2(pixel), vec4(reflCol, 1.0));
}
