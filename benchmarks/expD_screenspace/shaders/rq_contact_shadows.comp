#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) uniform sampler2D depthTex;
layout(set = 0, binding = 2, r8) uniform writeonly image2D outContactShadow;

layout(push_constant) uniform PushConstants {
    mat4 invViewProj;
    vec4 lightDir;
    uvec2 resolution;
    uint samplesPerPixel;
    float maxDistance;
} pc;

uint hash(uint x) {
    x += (x << 10u);
    x ^= (x >> 6u);
    x += (x << 3u);
    x ^= (x >> 11u);
    x += (x << 15u);
    return x;
}

float rand(inout uint seed) {
    seed = hash(seed);
    return float(seed) / 4294967295.0;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.resolution.x || pixel.y >= pc.resolution.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.resolution);
    float depth = textureLod(depthTex, uv, 0.0).r;
    if (depth >= 1.0) {
        imageStore(outContactShadow, ivec2(pixel), vec4(1.0));
        return;
    }

    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosH = pc.invViewProj * ndc;
    vec3 worldPos = worldPosH.xyz / worldPosH.w;

    vec3 L = normalize(pc.lightDir.xyz);
    uint seed = pixel.y * pc.resolution.x + pixel.x + 3333u;
    uint spp = max(1u, pc.samplesPerPixel);
    float vis = 0.0;

    for (uint i = 0; i < spp; i++) {
        vec3 dir = L;
        if (spp > 1) {
            float jx = (rand(seed) - 0.5) * 0.04;
            float jy = (rand(seed) - 0.5) * 0.04;
            float jz = (rand(seed) - 0.5) * 0.04;
            dir = normalize(L + vec3(jx, jy, jz));
        }

        rayQueryEXT rq;
        vec3 origin = worldPos + vec3(0, 0.02, 0);
        rayQueryInitializeEXT(
            rq,
            topLevelAS,
            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT | gl_RayFlagsOpaqueEXT,
            0xFF,
            origin,
            0.01,
            dir,
            pc.maxDistance
        );
        while (rayQueryProceedEXT(rq)) {
            rayQueryConfirmIntersectionEXT(rq);
        }

        if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
            vis += 1.0;
        }
    }

    imageStore(outContactShadow, ivec2(pixel), vec4(vis / float(spp)));
}
