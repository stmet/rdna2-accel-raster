#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) uniform sampler2D depthTex;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outRQR;

layout(push_constant) uniform PushConstants {
    mat4 invViewProj;
    vec4 camPos;
    uvec2 resolution;
    uint samplesPerPixel;
    float maxDistance;
} pc;

uint hash(uint x) {
    x += (x << 10u);
    x ^= (x >> 6u);
    x += (x << 3u);
    x ^= (x >> 11u);
    x += (x << 15u);
    return x;
}

float rand(inout uint seed) {
    seed = hash(seed);
    return float(seed) / 4294967295.0;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.resolution.x || pixel.y >= pc.resolution.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.resolution);
    float depth = textureLod(depthTex, uv, 0.0).r;
    if (depth >= 1.0) {
        imageStore(outRQR, ivec2(pixel), vec4(0.05, 0.05, 0.08, 1.0));
        return;
    }

    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosH = pc.invViewProj * ndc;
    vec3 worldPos = worldPosH.xyz / worldPosH.w;

    vec2 texel = 1.0 / vec2(pc.resolution);
    float depthR = textureLod(depthTex, uv + vec2(texel.x, 0.0), 0.0).r;
    float depthU = textureLod(depthTex, uv + vec2(0.0, texel.y), 0.0).r;
    vec4 posRH = pc.invViewProj * vec4((uv + vec2(texel.x, 0.0)) * 2.0 - 1.0, depthR, 1.0);
    vec4 posUH = pc.invViewProj * vec4((uv + vec2(0.0, texel.y)) * 2.0 - 1.0, depthU, 1.0);
    vec3 normal = normalize(cross(posRH.xyz / posRH.w - worldPos, posUH.xyz / posUH.w - worldPos));

    vec3 V = normalize(worldPos - pc.camPos.xyz);
    vec3 R = reflect(V, normal);

    uint seed = pixel.y * pc.resolution.x + pixel.x + 8888u;
    uint spp = max(1u, pc.samplesPerPixel);
    vec3 accumCol = vec3(0.0);

    for (uint i = 0; i < spp; i++) {
        vec3 rayDir = R;
        if (spp > 1) {
            // Slight jitter for roughness simulation
            float jx = (rand(seed) - 0.5) * 0.05;
            float jy = (rand(seed) - 0.5) * 0.05;
            float jz = (rand(seed) - 0.5) * 0.05;
            rayDir = normalize(R + vec3(jx, jy, jz));
        }

        rayQueryEXT rq;
        vec3 origin = worldPos + normal * 0.05;
        rayQueryInitializeEXT(
            rq,
            topLevelAS,
            gl_RayFlagsOpaqueEXT,
            0xFF,
            origin,
            0.02,
            rayDir,
            pc.maxDistance
        );
        while (rayQueryProceedEXT(rq)) {
            rayQueryConfirmIntersectionEXT(rq);
        }

        vec3 sampleCol = vec3(0.05, 0.05, 0.08); // Sky
        if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            sampleCol = vec3(0.6, 0.65, 0.7); // Geometry reflection
        }
        accumCol += sampleCol;
    }

    imageStore(outRQR, ivec2(pixel), vec4(accumCol / float(spp), 1.0));
}
