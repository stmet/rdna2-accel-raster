#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 64) in;

struct InstanceData {
    vec4 aabbMin;
    vec4 aabbMax;
};

layout(std430, binding = 0, set = 0) readonly buffer InstanceBuffer {
    InstanceData instances[];
};

layout(std430, binding = 1, set = 0) writeonly buffer VisibilityBuffer {
    uint visible[];
};

layout(binding = 2, set = 0) uniform accelerationStructureEXT occluderTLAS;

layout(push_constant) uniform PushConstants {
    vec4 camPos;
    vec4 frustumPlanes[6];
    uint instanceCount;
    uint sampleCount; // 1 or 5
} pc;

bool frustumCull(vec3 bmin, vec3 bmax) {
    for (int i = 0; i < 6; i++) {
        vec3 p = bmin;
        if (pc.frustumPlanes[i].x >= 0.0) p.x = bmax.x;
        if (pc.frustumPlanes[i].y >= 0.0) p.y = bmax.y;
        if (pc.frustumPlanes[i].z >= 0.0) p.z = bmax.z;

        if (dot(pc.frustumPlanes[i].xyz, p) + pc.frustumPlanes[i].w < 0.0) {
            return true;
        }
    }
    return false;
}

bool testVisibilityRay(vec3 origin, vec3 target) {
    vec3 toTarget = target - origin;
    float dist = length(toTarget);
    if (dist <= 0.1) return true; // At camera position

    vec3 dir = toTarget / dist;
    float maxDist = dist - 0.05;

    rayQueryEXT rq;
    rayQueryInitializeEXT(
        rq,
        occluderTLAS,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT,
        0xFF,
        origin,
        0.05,
        dir,
        maxDist
    );

    while (rayQueryProceedEXT(rq)) {
        // traversal
    }

    // If intersection committed, it was occluded
    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        return false; // Occluded
    }
    return true; // Ray reached the target unobstructed!
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.instanceCount) return;

    vec3 bmin = instances[idx].aabbMin.xyz;
    vec3 bmax = instances[idx].aabbMax.xyz;

    // 1. Frustum Cull (ALU only)
    if (frustumCull(bmin, bmax)) {
        visible[idx] = 0;
        return;
    }

    vec3 center = (bmin + bmax) * 0.5;

    // Test sample counts: 1, 3, 5, 9
    // Test ray 1: center
    if (testVisibilityRay(pc.camPos.xyz, center)) {
        visible[idx] = 1;
        return;
    }

    if (pc.sampleCount >= 3) {
        // Sample 2 & 3: two diagonal corners
        vec3 c0 = vec3(bmin.x, bmin.y, bmin.z);
        vec3 c1 = vec3(bmax.x, bmax.y, bmax.z);
        if (testVisibilityRay(pc.camPos.xyz, c0) || testVisibilityRay(pc.camPos.xyz, c1)) {
            visible[idx] = 1;
            return;
        }
    }

    if (pc.sampleCount >= 5) {
        // Sample 4 & 5: remaining front-facing corners
        vec3 c2 = vec3(bmax.x, bmin.y, bmin.z);
        vec3 c3 = vec3(bmin.x, bmax.y, bmax.z);
        if (testVisibilityRay(pc.camPos.xyz, c2) || testVisibilityRay(pc.camPos.xyz, c3)) {
            visible[idx] = 1;
            return;
        }
    }

    if (pc.sampleCount >= 9) {
        // Sample 6, 7, 8, 9: back corners
        vec3 c4 = vec3(bmin.x, bmin.y, bmax.z);
        vec3 c5 = vec3(bmax.x, bmin.y, bmax.z);
        vec3 c6 = vec3(bmin.x, bmax.y, bmin.z);
        vec3 c7 = vec3(bmax.x, bmax.y, bmin.z);
        if (testVisibilityRay(pc.camPos.xyz, c4) || testVisibilityRay(pc.camPos.xyz, c5) ||
            testVisibilityRay(pc.camPos.xyz, c6) || testVisibilityRay(pc.camPos.xyz, c7)) {
            visible[idx] = 1;
            return;
        }
    }

    visible[idx] = 0; // Completely occluded
}
