#version 450

layout(local_size_x = 16, local_size_y = 16) in;

struct LightData {
    vec4 posRadius;
    vec4 color;
    mat4 lightViewProj;
};

layout(std430, set = 0, binding = 0) readonly buffer LightsBuffer {
    LightData lights[];
};

layout(set = 0, binding = 1) uniform sampler2D depthTex;
layout(set = 0, binding = 2) uniform sampler2DArray shadowMaps; // Array of shadow maps for lights
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D outColor;

layout(push_constant) uniform PushConstants {
    mat4 invViewProj;
    mat4 view;
    uvec2 resolution;
    uint lightCount;
    float pcfFilterRadius;
} pc;

shared uint s_minDepthUint;
shared uint s_maxDepthUint;
shared uint s_tileLightCount;
shared uint s_tileLightIndices[256];

void main() {
    uint localIdx = gl_LocalInvocationIndex;
    if (localIdx == 0) {
        s_minDepthUint = 0xFFFFFFFF;
        s_maxDepthUint = 0;
        s_tileLightCount = 0;
    }
    barrier();

    uvec2 pixel = gl_GlobalInvocationID.xy;
    float depth = 1.0;
    if (pixel.x < pc.resolution.x && pixel.y < pc.resolution.y) {
        vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.resolution);
        depth = textureLod(depthTex, uv, 0.0).r;
        uint depthUint = floatBitsToUint(depth);
        atomicMin(s_minDepthUint, depthUint);
        atomicMax(s_maxDepthUint, depthUint);
    }
    barrier();

    // Tile bounds in view space
    float minDepth = uintBitsToFloat(s_minDepthUint);
    float maxDepth = uintBitsToFloat(s_maxDepthUint);

    // Bin lights intersecting tile
    uint totalLights = pc.lightCount;
    for (uint i = localIdx; i < totalLights; i += 256) {
        vec3 lightPos = lights[i].posRadius.xyz;
        float radius = lights[i].posRadius.w;
        vec4 lightPosV = pc.view * vec4(lightPos, 1.0);

        // Simple Z depth test
        if (-lightPosV.z + radius >= minDepth && -lightPosV.z - radius <= maxDepth + 50.0) {
            uint slot = atomicAdd(s_tileLightCount, 1);
            if (slot < 256) {
                s_tileLightIndices[slot] = i;
            }
        }
    }
    barrier();

    if (pixel.x >= pc.resolution.x || pixel.y >= pc.resolution.y || depth >= 1.0) {
        if (pixel.x < pc.resolution.x && pixel.y < pc.resolution.y) {
            imageStore(outColor, ivec2(pixel), vec4(0.05, 0.05, 0.08, 1.0));
        }
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.resolution);
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosH = pc.invViewProj * ndc;
    vec3 worldPos = worldPosH.xyz / worldPosH.w;

    // Normal approximation
    vec2 texel = 1.0 / vec2(pc.resolution);
    float depthR = textureLod(depthTex, uv + vec2(texel.x, 0.0), 0.0).r;
    float depthU = textureLod(depthTex, uv + vec2(0.0, texel.y), 0.0).r;
    vec4 posRH = pc.invViewProj * vec4((uv + vec2(texel.x, 0.0)) * 2.0 - 1.0, depthR, 1.0);
    vec4 posUH = pc.invViewProj * vec4((uv + vec2(0.0, texel.y)) * 2.0 - 1.0, depthU, 1.0);
    vec3 normal = normalize(cross(posRH.xyz / posRH.w - worldPos, posUH.xyz / posUH.w - worldPos));

    vec3 accumLight = vec3(0.03); // Ambient
    uint tileLights = min(s_tileLightCount, 256u);

    for (uint k = 0; k < tileLights; k++) {
        uint lightIdx = s_tileLightIndices[k];
        vec3 lPos = lights[lightIdx].posRadius.xyz;
        float radius = lights[lightIdx].posRadius.w;
        vec3 lCol = lights[lightIdx].color.rgb;

        vec3 toLight = lPos - worldPos;
        float dist = length(toLight);
        if (dist > radius || dist < 0.001) continue;

        vec3 L = toLight / dist;
        float NdotL = max(0.0, dot(normal, L));
        if (NdotL <= 0.0) continue;

        float atten = clamp(1.0 - dist / radius, 0.0, 1.0);
        atten *= atten;

        // Shadow map PCF sampling
        vec4 lightClip = lights[lightIdx].lightViewProj * vec4(worldPos + normal * 0.08, 1.0);
        vec3 lightNDC = lightClip.xyz / lightClip.w;
        vec2 shadowUV = lightNDC.xy * 0.5 + 0.5;

        float shadowFactor = 1.0;
        if (shadowUV.x >= 0.0 && shadowUV.x <= 1.0 && shadowUV.y >= 0.0 && shadowUV.y <= 1.0 && lightNDC.z >= 0.0 && lightNDC.z <= 1.0) {
            float shadowDepth = texture(shadowMaps, vec3(shadowUV, float(lightIdx))).r;
            float bias = 0.002;
            shadowFactor = (lightNDC.z - bias > shadowDepth) ? 0.0 : 1.0;
        }

        accumLight += lCol * (NdotL * atten * shadowFactor);
    }

    imageStore(outColor, ivec2(pixel), vec4(accumLight, 1.0));
}
