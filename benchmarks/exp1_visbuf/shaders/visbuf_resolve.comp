#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0, set = 0) readonly buffer VisBuffer {
    uint64_t pixels[];
};

layout(binding = 1, set = 0, r32ui) uniform writeonly uimage2D outVisBuf;

layout(push_constant) uniform PushConstants {
    uvec2 resolution;
} pc;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.resolution.x || pixel.y >= pc.resolution.y) return;

    uint idx = pixel.y * pc.resolution.x + pixel.x;
    uint64_t val = pixels[idx];

    // If initial depth ~ 1.0 (0xFFFFFFFF or max float)
    uint primId = 0;
    if (val != 0xFFFFFFFFFFFFFFFFUL) {
        primId = uint(val & 0xFFFFFFFFUL);
    }

    imageStore(outVisBuf, ivec2(pixel), uvec4(primId, 0, 0, 0));
}
