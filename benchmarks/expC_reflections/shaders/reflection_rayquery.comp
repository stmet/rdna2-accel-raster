#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1) uniform sampler2D depthTex;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D outReflection;

layout(push_constant) uniform PushConstants {
    mat4 invViewProj;
    vec4 camPos;
    vec4 mirrorPlane; // (nx, ny, nz, d)
    uvec2 resolution;
    float coverageFraction; // 0.0 to 1.0 of screen height / area
    float maxRayDist;
} pc;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.resolution.x || pixel.y >= pc.resolution.y) return;

    // Check if pixel is within mirror coverage fraction
    // Mirror covers the bottom pc.coverageFraction of the screen
    float normY = float(pixel.y) / float(pc.resolution.y);
    float mirrorStart = 1.0 - pc.coverageFraction;

    if (normY < mirrorStart) {
        // Not a reflective pixel: 0 rays traced!
        imageStore(outReflection, ivec2(pixel), vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.resolution);
    float depth = textureLod(depthTex, uv, 0.0).r;
    if (depth >= 1.0) {
        imageStore(outReflection, ivec2(pixel), vec4(0.05, 0.05, 0.08, 1.0));
        return;
    }

    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosH = pc.invViewProj * ndc;
    vec3 worldPos = worldPosH.xyz / worldPosH.w;

    vec3 V = normalize(worldPos - pc.camPos.xyz);
    vec3 N = normalize(pc.mirrorPlane.xyz);
    vec3 R = reflect(V, N);

    // Trace 1 reflection ray against TLAS
    rayQueryEXT rq;
    vec3 rayOrigin = worldPos + N * 0.05;
    rayQueryInitializeEXT(
        rq,
        topLevelAS,
        gl_RayFlagsOpaqueEXT,
        0xFF,
        rayOrigin,
        0.02,
        R,
        pc.maxRayDist
    );

    while (rayQueryProceedEXT(rq)) {
        rayQueryConfirmIntersectionEXT(rq);
    }

    vec3 reflCol = vec3(0.05, 0.05, 0.08); // Sky
    if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        // Hit geometry: calculate simple diffuse shading
        float tHit = rayQueryGetIntersectionTEXT(rq, true);
        vec3 hitPos = rayOrigin + R * tHit;
        vec3 L = normalize(vec3(0.5, 0.8, 0.3));
        float diff = max(0.0, dot(vec3(0, 1, 0), L)) * 0.8 + 0.2;
        reflCol = vec3(0.6, 0.65, 0.7) * diff;
    }

    imageStore(outReflection, ivec2(pixel), vec4(reflCol, 1.0));
}
