#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D rasterReflectionTex;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outComposite;

layout(push_constant) uniform PushConstants {
    uvec2 resolution;
    float coverageFraction;
} pc;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.resolution.x || pixel.y >= pc.resolution.y) return;

    float normY = float(pixel.y) / float(pc.resolution.y);
    float mirrorStart = 1.0 - pc.coverageFraction;

    if (normY < mirrorStart) {
        imageStore(outComposite, ivec2(pixel), vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.resolution);
    vec4 col = textureLod(rasterReflectionTex, uv, 0.0);
    imageStore(outComposite, ivec2(pixel), col);
}
