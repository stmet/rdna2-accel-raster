#version 460

layout(local_size_x = 64) in;

struct PointLight {
    vec4 posRadius; // xyz = world pos, w = radius
    vec4 color;
};

#define MAX_LIGHTS_PER_CLUSTER 512

struct ClusterGridData {
    uint count;
    uint lightIndices[MAX_LIGHTS_PER_CLUSTER];
};

layout(std430, binding = 0, set = 0) readonly buffer LightBuffer {
    PointLight lights[];
};

layout(std430, binding = 1, set = 0) buffer ClusterGridBuffer {
    ClusterGridData clusterGrid[];
};

layout(std430, binding = 2, set = 0) buffer OverflowBuffer {
    uint overflowCount;
};

layout(push_constant) uniform PushConstants {
    mat4 view;
    mat4 proj;
    uvec4 clusterDims;
    vec2 zNearFar;
    uint lightCount;
    uint _pad;
} pc;

void main() {
    uint lightIdx = gl_GlobalInvocationID.x;
    if (lightIdx >= pc.lightCount) return;

    PointLight l = lights[lightIdx];
    vec3 wpos = l.posRadius.xyz;
    float radius = l.posRadius.w;

    // Transform light position to view space
    vec4 vpos4 = pc.view * vec4(wpos, 1.0);
    vec3 vpos = vpos4.xyz / vpos4.w;

    // View space Z is negative in Vulkan
    float zDist = -vpos.z;
    if (zDist + radius < pc.zNearFar.x || zDist - radius > pc.zNearFar.y) {
        return; // Light outside depth range
    }

    // Compute Z slice bounds using log depth
    float zMin = max(pc.zNearFar.x, zDist - radius);
    float zMax = min(pc.zNearFar.y, zDist + radius);

    float sliceScale = float(pc.clusterDims.z) / log(pc.zNearFar.y / pc.zNearFar.x);
    float sliceBias = -log(pc.zNearFar.x) * sliceScale;

    uint minZ = uint(clamp(log(zMin) * sliceScale + sliceBias, 0.0, float(pc.clusterDims.z - 1)));
    uint maxZ = uint(clamp(log(zMax) * sliceScale + sliceBias, 0.0, float(pc.clusterDims.z - 1)));

    // Conservative 8-corner projection of view-space AABB to NDC [-1, 1]
    float zNearBox = max(pc.zNearFar.x, zDist - radius);
    float zFarBox = min(pc.zNearFar.y, zDist + radius);

    float xs[2] = float[2](vpos.x - radius, vpos.x + radius);
    float ys[2] = float[2](vpos.y - radius, vpos.y + radius);
    float zs[2] = float[2](-zNearBox, -zFarBox);

    vec2 ndcMin = vec2(1e9);
    vec2 ndcMax = vec2(-1e9);

    if (zDist <= radius) {
        ndcMin = vec2(-1.0);
        ndcMax = vec2(1.0);
    } else {
        for (int ix = 0; ix < 2; ix++) {
            for (int iy = 0; iy < 2; iy++) {
                for (int iz = 0; iz < 2; iz++) {
                    vec4 p = pc.proj * vec4(xs[ix], ys[iy], zs[iz], 1.0);
                    vec2 ndc = p.xy / p.w;
                    ndcMin = min(ndcMin, ndc);
                    ndcMax = max(ndcMax, ndc);
                }
            }
        }
    }

    vec2 uvMin = clamp(ndcMin * 0.5 + 0.5, 0.0, 1.0);
    vec2 uvMax = clamp(ndcMax * 0.5 + 0.5, 0.0, 1.0);

    uint minX = uint(clamp(uvMin.x * float(pc.clusterDims.x), 0.0, float(pc.clusterDims.x - 1)));
    uint maxX = uint(clamp(uvMax.x * float(pc.clusterDims.x), 0.0, float(pc.clusterDims.x - 1)));

    uint minY = uint(clamp(uvMin.y * float(pc.clusterDims.y), 0.0, float(pc.clusterDims.y - 1)));
    uint maxY = uint(clamp(uvMax.y * float(pc.clusterDims.y), 0.0, float(pc.clusterDims.y - 1)));

    // Scatter light index into overlapping clusters
    for (uint z = minZ; z <= maxZ; z++) {
        for (uint y = minY; y <= maxY; y++) {
            for (uint x = minX; x <= maxX; x++) {
                uint cIdx = x + y * pc.clusterDims.x + z * pc.clusterDims.x * pc.clusterDims.y;
                uint slot = atomicAdd(clusterGrid[cIdx].count, 1);
                if (slot < MAX_LIGHTS_PER_CLUSTER) {
                    clusterGrid[cIdx].lightIndices[slot] = lightIdx;
                } else {
                    atomicAdd(overflowCount, 1);
                }
            }
        }
    }
}
