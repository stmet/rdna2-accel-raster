#version 460

layout(local_size_x = 64) in;

struct PointLight {
    vec4 posRadius;
    vec4 color;
};

#define MAX_LIGHTS_PER_TILE 128

struct TileData {
    uint count;
    uint lightIndices[MAX_LIGHTS_PER_TILE];
};

layout(std430, binding = 0, set = 0) readonly buffer LightBuffer {
    PointLight lights[];
};

layout(std430, binding = 1, set = 0) buffer TileBuffer {
    TileData tiles[];
};

layout(push_constant) uniform PushConstants {
    mat4 view;
    mat4 invProj;
    uvec2 numTiles;
    uvec2 resolution;
    uint lightCount;
} pc;

shared uint s_tileLightCount;
shared uint s_tileLightIndices[MAX_LIGHTS_PER_TILE];

void main() {
    uint tileX = gl_WorkGroupID.x;
    uint tileY = gl_WorkGroupID.y;
    uint tileIdx = tileY * pc.numTiles.x + tileX;

    if (gl_LocalInvocationIndex == 0) {
        s_tileLightCount = 0;
    }
    barrier();

    // Tile bounding corners in screen space
    vec2 tMin = vec2(tileX * 16, tileY * 16);
    vec2 tMax = min(tMin + vec2(16.0), vec2(pc.resolution));

    vec2 uvMin = tMin / vec2(pc.resolution);
    vec2 uvMax = tMax / vec2(pc.resolution);

    // Tile frustum ray directions from camera
    vec4 c0 = pc.invProj * vec4(uvMin * 2.0 - 1.0, 1.0, 1.0);
    vec4 c1 = pc.invProj * vec4(uvMax * 2.0 - 1.0, 1.0, 1.0);
    vec3 dir0 = normalize(c0.xyz / c0.w);
    vec3 dir1 = normalize(c1.xyz / c1.w);

    vec3 tileCenterDir = normalize((dir0 + dir1) * 0.5);
    float tileRadiusAngle = length(dir1 - dir0) * 0.5;

    // Loop over all lights in parallel batches
    for (uint i = gl_LocalInvocationIndex; i < pc.lightCount; i += 64) {
        PointLight l = lights[i];
        vec4 vpos = pc.view * vec4(l.posRadius.xyz, 1.0);
        vec3 lv = vpos.xyz / vpos.w;

        float dist = -lv.z;
        if (dist > 0.5 && dist < 150.0) {
            vec3 toLight = normalize(lv);
            float angle = acos(clamp(dot(toLight, tileCenterDir), -1.0, 1.0));
            float lightAngularRadius = atan(l.posRadius.w, max(0.1, length(lv)));

            if (angle < (tileRadiusAngle + lightAngularRadius)) {
                uint slot = atomicAdd(s_tileLightCount, 1);
                if (slot < MAX_LIGHTS_PER_TILE) {
                    s_tileLightIndices[slot] = i;
                }
            }
        }
    }
    barrier();

    // Write back to global memory
    if (gl_LocalInvocationIndex == 0) {
        tiles[tileIdx].count = min(s_tileLightCount, uint(MAX_LIGHTS_PER_TILE));
    }
    for (uint i = gl_LocalInvocationIndex; i < min(s_tileLightCount, uint(MAX_LIGHTS_PER_TILE)); i += 64) {
        tiles[tileIdx].lightIndices[i] = s_tileLightIndices[i];
    }
}
