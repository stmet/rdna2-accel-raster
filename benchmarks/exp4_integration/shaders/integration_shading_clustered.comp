#version 460

layout(local_size_x = 16, local_size_y = 16) in;

struct PointLight {
    vec4 posRadius;
    vec4 color;
};

#define MAX_LIGHTS_PER_CLUSTER 512

struct ClusterGridData {
    uint count;
    uint lightIndices[MAX_LIGHTS_PER_CLUSTER];
};

layout(std430, binding = 0, set = 0) readonly buffer LightBuffer {
    PointLight lights[];
};

layout(std430, binding = 1, set = 0) readonly buffer ClusterGridBuffer {
    ClusterGridData clusterGrid[];
};

layout(binding = 2, set = 0) uniform sampler2D depthSampler;
layout(binding = 3, set = 0, rgba8) uniform writeonly image2D outShadingImage;

layout(push_constant) uniform PushConstants {
    mat4 invViewProj;
    mat4 view;
    uvec2 resolution;
    vec2 _pad0;
    uvec4 clusterDims;
    vec2 zNearFar;
    vec2 _pad1;
} pc;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.resolution.x || pixel.y >= pc.resolution.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.resolution);
    float depth = texture(depthSampler, uv).r;

    // Background / Sky
    if (depth >= 0.9999) {
        imageStore(outShadingImage, ivec2(pixel), vec4(0.01, 0.01, 0.02, 1.0));
        return;
    }

    vec4 clip = vec4(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0, depth, 1.0);
    vec4 world = pc.invViewProj * clip;
    vec3 worldPos = world.xyz / world.w;

    // Surface normal from depth gradient
    vec2 texelSize = 1.0 / vec2(pc.resolution);
    float dR = texture(depthSampler, uv + vec2(texelSize.x, 0.0)).r;
    float dD = texture(depthSampler, uv + vec2(0.0, texelSize.y)).r;

    vec3 normal = vec3(0.0, 1.0, 0.0);
    if (dR < 0.9999 && dD < 0.9999) {
        vec2 uvR = uv + vec2(texelSize.x, 0.0);
        vec4 wR = pc.invViewProj * vec4(uvR.x * 2.0 - 1.0, uvR.y * 2.0 - 1.0, dR, 1.0);
        vec3 posR = wR.xyz / wR.w;

        vec2 uvD = uv + vec2(0.0, texelSize.y);
        vec4 wD = pc.invViewProj * vec4(uvD.x * 2.0 - 1.0, uvD.y * 2.0 - 1.0, dD, 1.0);
        vec3 posD = wD.xyz / wD.w;

        vec3 n = cross(posR - worldPos, posD - worldPos);
        if (length(n) > 1e-6) {
            normal = normalize(n);
            if (normal.y < 0.0) normal = -normal;
        }
    }

    // Cluster indexing
    uint cx = uint(clamp(uv.x * float(pc.clusterDims.x), 0.0, float(pc.clusterDims.x - 1)));
    uint cy = uint(clamp(uv.y * float(pc.clusterDims.y), 0.0, float(pc.clusterDims.y - 1)));

    vec4 vpos = pc.view * vec4(worldPos, 1.0);
    float linearZ = -vpos.z;

    float sliceScale = float(pc.clusterDims.z) / log(pc.zNearFar.y / pc.zNearFar.x);
    float sliceBias = -log(pc.zNearFar.x) * sliceScale;
    uint cz = uint(clamp(log(max(linearZ, pc.zNearFar.x)) * sliceScale + sliceBias, 0.0, float(pc.clusterDims.z - 1)));

    uint clusterIdx = cx + cy * pc.clusterDims.x + cz * pc.clusterDims.x * pc.clusterDims.y;
    ClusterGridData grid = clusterGrid[clusterIdx];

    vec3 accumLight = vec3(0.02); // Ambient baseline
    uint count = min(grid.count, MAX_LIGHTS_PER_CLUSTER);
    for (uint i = 0; i < count; i++) {
        uint lIdx = grid.lightIndices[i];
        PointLight l = lights[lIdx];

        vec3 toLight = l.posRadius.xyz - worldPos;
        float dist = length(toLight);
        float radius = l.posRadius.w;
        if (dist < radius) {
            vec3 L = toLight / dist;
            float NdotL = max(0.0, dot(normal, L));
            float atten = max(0.0, 1.0 - dist / radius);
            atten *= atten;
            accumLight += l.color.rgb * (NdotL * atten);
        }
    }

    imageStore(outShadingImage, ivec2(pixel), vec4(clamp(accumLight, 0.0, 1.0), 1.0));
}
