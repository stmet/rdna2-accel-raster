#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1, r8) uniform writeonly image2D outAO;

layout(push_constant) uniform PushConstants {
    mat4 invViewProj;
    mat4 proj;
    uvec2 resolution;
    float sampleRadius;
    float bias;
} pc;

uint hash(uint x) {
    x += (x << 10u);
    x ^= (x >> 6u);
    x += (x << 3u);
    x ^= (x >> 11u);
    x += (x << 15u);
    return x;
}

float rand(inout uint seed) {
    seed = hash(seed);
    return float(seed) / 4294967295.0;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.resolution.x || pixel.y >= pc.resolution.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.resolution);
    float depth = textureLod(depthTex, uv, 0.0).r;
    if (depth >= 1.0) {
        imageStore(outAO, ivec2(pixel), vec4(1.0));
        return;
    }

    vec4 ndc = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPosH = pc.invViewProj * ndc;
    vec3 worldPos = worldPosH.xyz / worldPosH.w;

    vec2 texel = 1.0 / vec2(pc.resolution);
    float depthR = textureLod(depthTex, uv + vec2(texel.x, 0.0), 0.0).r;
    float depthU = textureLod(depthTex, uv + vec2(0.0, texel.y), 0.0).r;
    vec4 posRH = pc.invViewProj * vec4((uv + vec2(texel.x, 0.0)) * 2.0 - 1.0, depthR, 1.0);
    vec4 posUH = pc.invViewProj * vec4((uv + vec2(0.0, texel.y)) * 2.0 - 1.0, depthU, 1.0);
    vec3 normal = normalize(cross(posRH.xyz / posRH.w - worldPos, posUH.xyz / posUH.w - worldPos));

    uint seed = pixel.y * pc.resolution.x + pixel.x + 9876u;

    // 16 screen-space hemisphere samples
    float occlusion = 0.0;
    const int numSamples = 16;
    for (int i = 0; i < numSamples; i++) {
        // Random sample in hemisphere
        float rx = rand(seed) * 2.0 - 1.0;
        float ry = rand(seed) * 2.0 - 1.0;
        float rz = rand(seed);
        vec3 sampleDir = normalize(vec3(rx, ry, rz));
        if (dot(sampleDir, normal) < 0.0) sampleDir = -sampleDir;

        float scale = float(i) / float(numSamples);
        scale = mix(0.1, 1.0, scale * scale);
        vec3 samplePos = worldPos + sampleDir * (pc.sampleRadius * scale);

        // Project sample to screen
        vec4 sampleNDC = pc.proj * vec4(samplePos, 1.0);
        sampleNDC.xyz /= sampleNDC.w;
        vec2 sampleUV = sampleNDC.xy * 0.5 + 0.5;

        if (sampleUV.x >= 0.0 && sampleUV.x <= 1.0 && sampleUV.y >= 0.0 && sampleUV.y <= 1.0) {
            float sampleDepth = textureLod(depthTex, sampleUV, 0.0).r;
            vec4 actualPosH = pc.invViewProj * vec4(sampleUV * 2.0 - 1.0, sampleDepth, 1.0);
            vec3 actualPos = actualPosH.xyz / actualPosH.w;

            float rangeCheck = smoothstep(0.0, 1.0, pc.sampleRadius / abs(worldPos.z - actualPos.z + 0.001));
            occlusion += (actualPos.z >= samplePos.z + pc.bias ? 1.0 : 0.0) * rangeCheck;
        }
    }

    float ao = 1.0 - (occlusion / float(numSamples));
    imageStore(outAO, ivec2(pixel), vec4(clamp(ao, 0.0, 1.0)));
}
