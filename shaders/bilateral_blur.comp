#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D inTex;
layout(set = 0, binding = 1) uniform sampler2D depthTex;
layout(set = 0, binding = 2, r8) uniform writeonly image2D outFiltered;

layout(push_constant) uniform PushConstants {
    uvec2 resolution;
    vec2 blurDirection; // (1, 0) for horizontal, (0, 1) for vertical
    float depthThreshold;
} pc;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.resolution.x || pixel.y >= pc.resolution.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.resolution);
    float centerVal = textureLod(inTex, uv, 0.0).r;
    float centerDepth = textureLod(depthTex, uv, 0.0).r;

    if (centerDepth >= 1.0) {
        imageStore(outFiltered, ivec2(pixel), vec4(centerVal));
        return;
    }

    float totalWeight = 0.227027;
    float result = centerVal * totalWeight;

    const float weights[4] = { 0.1945946, 0.1216216, 0.054054, 0.016216 };
    vec2 texelSize = 1.0 / vec2(pc.resolution);

    for (int i = 1; i <= 4; i++) {
        vec2 offset = pc.blurDirection * (float(i) * texelSize);

        // Positive sample
        vec2 uvPos = uv + offset;
        float depthPos = textureLod(depthTex, uvPos, 0.0).r;
        float valPos = textureLod(inTex, uvPos, 0.0).r;
        float wPos = weights[i - 1] * (abs(depthPos - centerDepth) < pc.depthThreshold ? 1.0 : 0.0);
        result += valPos * wPos;
        totalWeight += wPos;

        // Negative sample
        vec2 uvNeg = uv - offset;
        float depthNeg = textureLod(depthTex, uvNeg, 0.0).r;
        float valNeg = textureLod(inTex, uvNeg, 0.0).r;
        float wNeg = weights[i - 1] * (abs(depthNeg - centerDepth) < pc.depthThreshold ? 1.0 : 0.0);
        result += valNeg * wNeg;
        totalWeight += wNeg;
    }

    imageStore(outFiltered, ivec2(pixel), vec4(result / max(totalWeight, 0.001)));
}
